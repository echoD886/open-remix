.claude/scheduled_tasks.lock
/.gstack/
/.omc/

# production
/build
/.codec-build/

# deploy
.vercel

# editors (keep .cursor/skills — cross-agent symlink to .claude/skills)
.idea
.vscode
.cursor/*
!.cursor/skills

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — local files hold secrets, never commit (keep .env.example tracked)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# database
/data/
src/config/db/schema.ts
src/config/db/.schema-build.lock/

# npm (project uses pnpm)
package-lock.json

# Runtime image uploads (no-storage local fallback)
/public/uploads/

# Research and cache (do not commit)
/docs/research/
/.blog-auto-cache/
