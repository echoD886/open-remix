# OpenRemix — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI, analytics) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.
#
# Cloudflare Workers production:
#   .env.production is a local input file only; it is gitignored and is not
#   available to the Worker at runtime. Put public VITE_* values in
#   wrangler.jsonc vars and sync secrets with:
#     pnpm cf:secrets:sync:dry
#     pnpm cf:secrets:sync
#     pnpm cf:env:check
# The sync/check scripts print key names only, never secret values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=https://openremix.app
VITE_APP_NAME="OpenRemix"
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Anti-Abuse (optional but recommended for production)
# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key for CAPTCHA verification
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION="Turn product images into campaign-ready product photos, ad variations, and product videos with OpenRemix."
VITE_APP_LOGO=/logo.webp
VITE_DEFAULT_LOCALE=en
# Optional. Set to your R2 public domain after uploading Seedance media.
# Example: https://assets.openremix.app
VITE_SEEDANCE_ASSET_BASE_URL=

# ---------------------------------------------------------------------------
# Local SEO / public business entity (optional)
# ---------------------------------------------------------------------------
# These are public NAP values and should match the visible footer,
# LocalBusiness JSON-LD, llms.txt, and Google Business Profile.
# LocalBusiness schema is disabled unless this is true and the NAP below is a verified real business entity.
VITE_BUSINESS_LOCAL_SEO_ENABLED=false
VITE_BUSINESS_NAME="OpenRemix"
VITE_BUSINESS_EMAIL=support@openremix.app
VITE_BUSINESS_PHONE=
VITE_BUSINESS_STREET_ADDRESS=
VITE_BUSINESS_ADDRESS_LOCALITY=
VITE_BUSINESS_ADDRESS_REGION=
VITE_BUSINESS_ADDRESS_REGION_NAME=
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_ADDRESS_COUNTRY=
VITE_BUSINESS_AREA_SERVED=
# VITE_BUSINESS_GEO_LATITUDE=
# VITE_BUSINESS_GEO_LONGITUDE=
# VITE_GOOGLE_BUSINESS_PROFILE_URL=
# VITE_BUSINESS_SAME_AS_URLS=
VITE_BUSINESS_PRICE_RANGE="$19.90-$299.00"

# ---------------------------------------------------------------------------
# Analytics / public site verification (optional)
# ---------------------------------------------------------------------------
# These IDs are public. They can also be managed in admin Settings.
VITE_GOOGLE_ANALYTICS_ID=
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_MICROSOFT_SITE_VERIFICATION=
VITE_MICROSOFT_CLARITY_ID=
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# VITE_PLAUSIBLE_DOMAIN=openremix.app

# Search discovery / IndexNow (optional)
# ---------------------------------------------------------------------------
# Used by /indexnow-key.txt and /api/indexnow/submit after publishing content.
# Generate INDEXNOW_KEY as a 8-128 character key. Keep INDEXNOW_SECRET private.
# INDEXNOW_KEY=
# INDEXNOW_SECRET=
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# ---------------------------------------------------------------------------
# Admin settings encryption (recommended)
# ---------------------------------------------------------------------------
# Encrypts secrets saved via admin Settings (AES-256-GCM) in the config table.
# Unset = plaintext storage. Once set, keep it stable — rotating or removing
# it orphans already-encrypted values (they fall back to env values).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (advanced / non-sqlite)
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: sqlite | postgres | mysql | turso | d1
#   PostgreSQL: postgresql://localhost:5432/dbname
#   MySQL:      mysql://localhost:3306/dbname
#   Turso:      libsql://<db>.turso.io   (also set DATABASE_AUTH_TOKEN below)
# DATABASE_AUTH_TOKEN=                # Turso auth token (required for turso)
# DB_SCHEMA=public                    # Postgres schema
# DB_SINGLETON_ENABLED=false          # reuse a single connection (serverless)
# DB_MAX_CONNECTIONS=1

# ---------------------------------------------------------------------------
# Auth (optional — AUTH_URL defaults to VITE_APP_URL)
# ---------------------------------------------------------------------------
# AUTH_URL=https://openremix.app
# BETTER_AUTH_SECRET=                # supported alias for AUTH_SECRET
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTH_ENABLED=true
# GOOGLE_ONE_TAP_ENABLED=true

# ---------------------------------------------------------------------------
# Provider fallbacks (optional — can also be saved in admin Settings)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=support@openremix.app
# STRIPE_ENABLED=true
# DEFAULT_PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SIGNING_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_MONTHLY_LAUNCH=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_MONTHLY_PLUS=
# STRIPE_PRICE_PRO_MONTHLY_MAX=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_PRO_YEARLY_PLUS=
# STRIPE_PRICE_PRO_YEARLY_MAX=
# STRIPE_PRICE_ENTERPRISE_YEARLY=
# STRIPE_PRICE_CREDITS_SMALL=
# STRIPE_PRICE_CREDITS_MEDIUM=
# STRIPE_PRICE_CREDITS_LARGE=
# EVOLINK_BASE_URL=https://api.evolink.ai
# EVOLINK_API_KEY=
# Exact Evolink/CDN hostnames allowed for first-party product-video transfer.
# PRODUCT_VIDEO_EVOLINK_OUTPUT_HOSTS=
# Server-only output from the production product-video probe/attestation job.
# Leave empty to hide all generative product-video routes (fail closed). Do not
# derive this value from the static model registry or accept it from a client.
# PRODUCT_VIDEO_RUNTIME_EVIDENCE_JSON=
# MODERATION_ENABLED=false
# MODERATION_OPENAI_BASE_URL=https://api.openai.com/v1
# MODERATION_OPENAI_API_KEY=
# MODERATION_BLOCK_THRESHOLD=0.90
# MODERATION_EXPLICIT_ADULT_THRESHOLD=0.98
# MODERATION_PROVIDER_NSFW_CHECK=false
# MODERATION_LOG_THRESHOLD=0.80

# R2 accepts either the scaffold r2_* names or common S3-style aliases.
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_DOMAIN=
# R2_UPLOAD_PATH=uploads
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=
