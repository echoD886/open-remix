{
  "name": "openremix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev --port 3000",
    "test": "pnpm i18n:compile && pnpm brand:check && pnpm test:safe-egress && pnpm test:scripts && pnpm test:unit && pnpm test:contracts && pnpm test:ui",
    "test:safe-egress": "tsx --test workers/product-video-safe-egress/src/*.test.ts",
    "test:scripts": "tsx --test --test-concurrency=1 scripts/*.test.ts",
    "test:unit": "node scripts/build-with-schema.mjs --node-env=test -- pnpm exec tsx --test src/core/ai/*.test.ts src/core/auth/*.test.ts src/core/payment/*.test.ts src/modules/payment/*.test.ts tests/unit/*.test.ts tests/unit/*.test.tsx",
    "test:contracts": "node scripts/build-with-schema.mjs --node-env=test -- pnpm exec tsx --test tests/contracts/*.test.ts",
    "test:ui": "node scripts/build-with-schema.mjs --node-env=test -- pnpm exec tsx --test src/**/*.test.tsx",
    "test:ai-image": "node scripts/build-with-schema.mjs --node-env=test -- pnpm exec tsx --test tests/unit/ai-*.test.ts tests/unit/image-*.test.ts tests/contracts/evolink-image.test.ts",
    "test:libwebp:workerd": "node scripts/test-libwebp-decoder-workerd.mjs",
    "test:integration": "node scripts/build-with-schema.mjs --provider=sqlite --node-env=test -- pnpm exec tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "typecheck": "pnpm i18n:compile && pnpm routes:generate && node scripts/build-with-schema.mjs --node-env=production -- pnpm exec tsc --noEmit --incremental false",
    "build": "pnpm brand:check && node scripts/build-with-schema.mjs --node-env=production -- vite build",
    "start": "node .output/server/index.mjs",
    "cf:build": "pnpm brand:check && pnpm rasterizer:assets:check && node scripts/build-with-schema.mjs --wrangler --node-env=production --nitro-preset=cloudflare_module --verify-cloudflare-bundle -- vite build",
    "cf:build:deploy": "pnpm brand:check && pnpm rasterizer:assets:check && node scripts/build-with-schema.mjs --wrangler --deploy-config --node-env=production --nitro-preset=cloudflare_module --verify-cloudflare-bundle -- vite build",
    "cf:bundle:check": "node scripts/check-cloudflare-bundle.mjs --codec --rasterizer",
    "codec:check": "node scripts/check-libwebp-decoder.mjs",
    "codec:build": "node scripts/build-libwebp-decoder.mjs",
    "brand:check": "node scripts/check-brand-consistency.mjs",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie baseLocale --output-structure message-modules --silent",
    "i18n:registry": "node scripts/build-dynamic-message-registry.mjs",
    "i18n:registry:check": "node scripts/build-dynamic-message-registry.mjs --check",
    "imgs:manifest": "node scripts/build-modern-image-manifest.mjs",
    "imgs:manifest:check": "node scripts/build-modern-image-manifest.mjs --check",
    "rasterizer:assets:check": "node scripts/build-editable-image-rasterizer-assets.mjs --check",
    "routes:generate": "tsr generate",
    "cf:env:check": "node scripts/check-cloudflare-runtime-env.mjs --mode=bundle-only",
    "cf:env:check:deploy": "node scripts/check-cloudflare-runtime-env.mjs --mode=deploy",
    "cf:secrets:sync": "node scripts/sync-cloudflare-secrets.mjs",
    "cf:secrets:sync:dry": "node scripts/sync-cloudflare-secrets.mjs --dry-run",
    "cf:deploy": "pnpm cf:env:check:deploy && pnpm cf:build:deploy && pnpm exec wrangler deploy --config wrangler.jsonc",
    "smoke:production": "node scripts/postdeploy-smoke.mjs",
    "indexnow:submit": "tsx scripts/with-env.ts node scripts/submit-indexnow.mjs",
    "postinstall": "mkdir -p data && (test -f src/config/db/schema.ts || node scripts/db-setup.mjs)",
    "db:setup": "node scripts/db-setup.mjs",
    "db:init-schema": "tsx scripts/with-env.ts tsx scripts/init-postgres-schema.ts",
    "db:analytics": "tsx scripts/with-env.ts tsx scripts/create-analytics-tables.ts",
    "db:push": "tsx scripts/with-env.ts drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "tsx scripts/with-env.ts drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/with-env.ts drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "tsx scripts/with-env.ts drizzle-kit studio --config=drizzle.config.ts",
    "rbac:init": "tsx scripts/with-env.ts tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts tsx scripts/assign-role.ts",
    "stripe:sync": "tsx scripts/sync-stripe.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@fontsource/noto-sans-sc": "5.2.9",
    "@fontsource/roboto-mono": "5.2.9",
    "@libsql/client": "^0.14.0",
    "@mdx-js/react": "^3.1.1",
    "@react-email/components": "^1.0.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-start": "^1.168.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@types/mdx": "^2.0.13",
    "aws4fetch": "^1.0.0",
    "better-auth": "1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.2.0",
    "motion": "^12.38.0",
    "mysql2": "^3.14.0",
    "nanoid": "^5.0.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.0.0",
    "resend": "^4.0.0",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/router-cli": "1.167.28",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.4",
    "fontkit": "2.0.4",
    "nitro": "3.0.260603-beta",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "js-yaml": "4.3.0",
      "linkify-it": "5.0.2",
      "next": "16.2.11",
      "qs": "6.15.3",
      "ws": "8.21.0"
    }
  }
}
